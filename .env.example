# Copy to .env and fill in. .env is gitignored — never commit real keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
FMP_API_KEY=
THETADATA_API_KEY=

# Schwab (post-validation transition)
# Schwab live trading — the four names SchwabCredentials.from_env() actually
# reads. Obtain: developer.schwab.com app -> client id/secret; run the OAuth
# code flow once to mint a refresh token (expires ~7 days, must be re-minted);
# account hash from GET /trader/v1/accounts/accountNumbers.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REFRESH_TOKEN=
SCHWAB_ACCOUNT_HASH=
